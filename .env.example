# OpenAI-compatible LLM settings. Required for real translation in the Web/job workflow.
# Tests may enable translation.allow_mock_fallback, but production runs should use a real LLM.
LLM_API_KEY=
LLM_BASE_URL=https://token.cxtfun.com/v1
LLM_MODEL=gpt-5.5
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

HF_TOKEN=

DOUBAO_ASR_API_KEY=
DOUBAO_TOS_ACCESS_KEY_ID=
DOUBAO_TOS_SECRET_ACCESS_KEY=

TTS_MODEL=speech-2.8-hd
